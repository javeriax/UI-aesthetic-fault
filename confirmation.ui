<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ConfirmationWindow</class>
 <widget class="QWidget" name="ConfirmationWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1024</width>
    <height>768</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Part Confirmation / حصہ کی تصدیق</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
   /* --- Overall Background --- */
   #ConfirmationWindow {
       background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                   stop:0 #e8eaf6, stop:1 #f5f5f5);
       font-family: 'Segoe UI', Arial, sans-serif;
   }
   
   /* --- Title Label --- */
   QLabel#confirmationLabel {
       color: #1565c0;
       font-size: 32pt;
       font-weight: 600;
       qproperty-alignment: 'AlignCenter';
       padding: 20px;
       background: transparent;
   }
   
   /* --- Selected Part Display (Non-interactive) --- */
   QToolButton#selectedPartButton {
       background-color: white;
       color: #212121;
       border: 3px solid #1976d2;
       border-radius: 16px;
       font-size: 20pt;
       font-weight: 600;
       padding: 20px;
       min-width: 300px;  /* Ensuring minimum width */
       min-height: 250px; /* Ensuring minimum height */
   }
   
   QToolButton#selectedPartButton:disabled {
       background-color: white;
       color: #212121;
       border: 3px solid #1976d2;
       opacity: 1.0;
   }
   
   /* --- Navigation Buttons --- */
   QPushButton {
       background-color: #1976d2;
       color: white;
       font-size: 16pt;
       font-weight: 600;
       padding: 15px 30px;
       border-radius: 10px;
       border: none;
       min-width: 200px;
       min-height: 60px;
   }
   
   QPushButton:hover {
       background-color: #1565c0;
       border: 2px solid #0d47a1;
   }
   
   QPushButton:pressed {
       background-color: #0d47a1;
   }
   
   QPushButton#backButton {
       background-color: #757575;
   }
   
   QPushButton#backButton:hover {
       background-color: #616161;
       border: 2px solid #424242;
   }
   
   QPushButton#backButton:pressed {
       background-color: #424242;
   }
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout" stretch="2,5,2">
<!-- Title Label -->
   <item>
    <widget class="QLabel" name="confirmationLabel">
     <property name="text">
      <string>Confirm Part Placement / حصہ کی جگہ کی تصدیق کریں</string>
     </property>
    </widget>
   </item>
<!-- Selected Part Display -->
   <item alignment="Qt::AlignCenter">
    <widget class="QToolButton" name="selectedPartButton">
     <property name="text">
      <string>Part X</string> <!-- Placeholder text -->
     </property>
     <property name="toolButtonStyle">
      <enum>Qt::ToolButtonTextUnderIcon</enum>  <!-- Text under the icon -->
     </property>
     <property name="iconSize">
      <size>
       <width>200</width> <!-- Icon size -->
       <height>150</height> <!-- Icon size -->
      </size>
     </property>
     <property name="focusPolicy">
      <enum>Qt::NoFocus</enum>
     </property>
     <property name="autoRaise">
      <bool>true</bool>
     </property>
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Fixed">  <!-- Horizontal expansion, fixed vertical -->
       <horstretch>1</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="minimumSize">
      <size>
       <width>300</width>  <!-- Minimum width for the button -->
       <height>250</height> <!-- Minimum height for the button -->
      </size>
     </property>
    </widget>
   </item>
<!-- Navigation Buttons -->
   <item>
    <layout class="QHBoxLayout" name="buttonLayout">
     <item alignment="Qt::AlignLeft">
      <widget class="QPushButton" name="backButton">
       <property name="text">
        <string>Back / واپس</string>
       </property>
      </widget>
     </item>
     <item alignment="Qt::AlignRight">
      <widget class="QPushButton" name="nextButton">
       <property name="text">
        <string>Next / اگلا</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
