  <property name="windowTitle">
   <string>Part Summary / حصہ کا خلاصہ</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
#FinalSummaryScreen {
    background-color: #f5f7fa;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Header */
#headerFrame {
    background-color: #1565c0;
    border-bottom: 2px solid #0d47a1;
}
#headerLabel {
    color: white;
    font-size: 26pt;
    font-weight: 600;
    letter-spacing: 1px;
}

/* Main content */
#contentFrame {
    background-color: white;
    border-radius: 20px;
    padding: 30px;
    border: 1px solid #e0e0e0;
}

/* Image box */
#partImageLabel {
    border: 3px solid #ddd;
    border-radius: 12px;
    background-color: #ffffff;
}

/* Labels */
#partNameLabel, 
#resultDetailLabel {
    font-size: 18pt;
    font-weight: 500;
    color: #333;
}

/* GOOD/BAD Status */
#finalStatusLabel {
    font-size: 36pt;
    font-weight: bold;
    padding: 25px;
    border-radius: 15px;
    text-align: center;
    background-color: #ffffff;
    border: none;
    color: #333333;
}

/* Back Button */
#backButton {
    background-color: #1976d2;
    color: white;
    font-size: 16pt;
    font-weight: bold;
    border-radius: 12px;
    padding: 14px 40px;
}
#backButton:hover {
    background-color: #1565c0;
}
   </string>
