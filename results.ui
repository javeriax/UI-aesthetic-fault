  <property name="styleSheet">
   <string notr="true">
#ResultsScreen {
    background-color: #f0f2f5;
    font-family: Arial, sans-serif;
}

/* Header */
#headerFrame {
    background-color: #1976d2;
}
#headerLabel {
    color: white;
    font-size: 20pt;
    font-weight: bold;
}

/* Status Label */
#statusLabel {
    font-size: 18pt;
    font-weight: bold;
    color: #2e7d32; /* Default GOOD green */
    margin: 10px;
}

/* Error Percentage Label */
#errorPercentLabel {
    font-size: 16pt;
    font-weight: bold;
    color: #444;
    margin: 5px;
}


/* Grid images */
#gridFrame QLabel {
    border: 2px dashed #bbb;
    border-radius: 8px;
    min-width: 100px;
    min-height: 80px;
    background-color: #ffffff;
}

/* Buttons */
QPushButton {
    font-size: 14pt;
    font-weight: bold;
    border-radius: 10px;
    padding: 10px 25px;
    cursor: pointing-hand;
}
#nextButton {
    background-color: #1976d2; /* Primary blue, matching header */
    color: white;
}
#nextButton:hover {
    background-color: #1565c0; /* Darker blue on hover */
}
#supervisorButton {
    background-color: #d32f2f;
    color: white;
}
#supervisorButton:hover {
    background-color: #b71c1c;
}
   </string>
